{
  "expo": {
    "name": "Cidade nas Costas",
    "slug": "cidade-nas-costas",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#2e2418",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2e2418"
    },
    "androidStatusBar": {
      "hidden": true,
      "backgroundColor": "#2e2418"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#2e2418"
    },
    "android": {
      "package": "com.claude.cidadenascostas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8cd468"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.claude.cidadenascostas",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "name": "Cidade nas Costas",
      "shortName": "Cidade nas Costas",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "themeColor": "#2e2418",
      "backgroundColor": "#2e2418"
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/lilita-one/LilitaOne_400Regular.ttf",
            "node_modules/@expo-google-fonts/nunito/Nunito_700Bold.ttf",
            "node_modules/@expo-google-fonts/nunito/Nunito_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/nunito/Nunito_900Black.ttf"
          ]
        }
      ]
    ]
  }
}
